# Runtime Bionic Inventory backend.
BIONIC_INVENTORY_API_URL=https://inventory-backend.team4909.org/api
BIONIC_INVENTORY_API_KEY=replace-with-a-producer-key

# Required only while the one-time Neon migration remains available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Set a strong shared password for inventory access.
APP_PASSWORD=replace-with-a-long-random-team-password

# Generate a secret with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. The default session duration is seven days.
SESSION_TTL_HOURS=168
